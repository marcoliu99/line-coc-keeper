# Discord bot token — from
# discord.com/developers/applications > your app > Bot > Reset Token.
# Also remember to switch on the "Message Content" privileged intent there,
# under Bot > Privileged Gateway Intents, or the bot won't see message text.
DISCORD_BOT_TOKEN=

# Which LLM plays the Keeper: "anthropic", "gemini", or "openai"
LLM_PROVIDER=anthropic

# Anthropic API key (console.anthropic.com), separate from your Claude Code login
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google AI Studio API key (aistudio.google.com/apikey), only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Double-check the current flash model id at https://ai.google.dev before relying on this default
GEMINI_MODEL=gemini-flash-latest

# OpenAI API key (platform.openai.com), only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
# "gpt-5.6-luna" is a best-effort transcription, not a verified model id — double-check
# the exact string at platform.openai.com/docs/models before relying on this default
OPENAI_MODEL=gpt-5.6-luna

# Where per-group game state (characters, scenario text, log) is persisted.
# Scenario page images (PNG) live directly under this directory; everything
# else (group state, character mirror, Scenario/Memory RAG index caches) is
# stored in the SQLite database below instead, not as files under here.
DATA_DIR=data/groups

# SQLite database file — see app/db.py. Defaults to sitting next to DATA_DIR.
DB_PATH=data/coc_bot.db

# Heuristic context-budget caps — see the comments in app/config.py for the
# reasoning. Tune down if your model's context window is smaller than Claude
# Sonnet's ~200K tokens; tune up if you've checked it comfortably fits more.
MAX_SCENARIO_CHARS=240000
MAX_LOG_TURNS=40

# Scenario RAG (app/scenario_rag.py) — opt-in, off by default here (the
# maintainer's own live .env runs with this on). Off: the full scenario text
# is stuffed into the (cached) system prompt as always, capped by
# MAX_SCENARIO_CHARS. On: the Keeper gets a search_scenario tool instead and
# queries the scenario per-turn — local lexical (BM25) search always runs;
# if OPENAI_API_KEY is set below, it's blended with OpenAI embeddings for
# semantic matching too (SCENARIO_RAG_EMBEDDING_MODEL/_WEIGHT). No OpenAI key
# still works, just BM25-only. See README's 限制 section before turning this on.
SCENARIO_RAG_ENABLED=false
SCENARIO_RAG_TOP_K=5
SCENARIO_RAG_EMBEDDING_MODEL=text-embedding-3-small
SCENARIO_RAG_EMBEDDING_WEIGHT=0.5

# Sampling temperature for the Keeper's own narration (app/keeper.py's
# run_turn, via each provider's run_conversation — not the analyze_image/
# analyze_text extraction paths, which stay at each provider's default).
# Lower than each provider's own default on purpose, for a more consistent
# cold-observer tone and less "drift" in how dice/rule results get restated.
# See README section 14. If your configured model rejects this parameter
# outright (some reasoning-tier models do), app/providers/openai_provider.py
# detects that once and stops sending it for the rest of the process.
KEEPER_TEMPERATURE=0.6

# Reasoning effort for the Keeper's own narration — OpenAI Responses API only
# (LLM_PROVIDER=openai; Anthropic/Gemini have no equivalent in this project's
# adapters). One of none/minimal/low/medium/high/xhigh/max, or empty string
# to omit the parameter entirely (the old default behavior — inherits
# whatever the API's own per-model default is). Same graceful-degrade as
# KEEPER_TEMPERATURE if the configured model rejects this parameter outright.
KEEPER_REASONING_EFFORT=medium

# Async provider/RAG/Discord operation boundaries. These are per-operation
# limits, not a timeout for the entire game turn. LLM timeouts retry at most
# once; embedding and Discord operations fall back without blind duplicate
# sends. MAX_TOOL_ITERATIONS keeps the provider loop bounded.
MAX_TOOL_ITERATIONS=8
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_TIMEOUT_RETRIES=1
EMBEDDING_REQUEST_TIMEOUT_SECONDS=20
DISCORD_REQUEST_TIMEOUT_SECONDS=10
TOOL_EXECUTION_TIMEOUT_SECONDS=30
PROVIDER_SHUTDOWN_GRACE_SECONDS=5
SCENARIO_RAG_PREWARM_ENABLED=false
SCENARIO_RAG_PREWARM_MAX_CONCURRENT=1

# Structured performance logging and ordinary developer text logging.
# LOG_ENABLED=false avoids timing/token/JSON payload overhead by default.
LOG_ENABLED=false
LOG_TEXT_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=
LOG_SLOW_REQUEST_MS=3000
LOG_SLOW_OPERATION_MS=1000
LOG_HASH_IDENTIFIERS=true
LOG_INCLUDE_USAGE=true

# Optional local/staging profiler for scripts/start_bot.sh. Keep off in normal
# operation. Allowed values: off, pyinstrument, py-spy.
BOT_PROFILER=off
