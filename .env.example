# LINE Developers > Messaging API channel (only needed to run app/main.py)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Public HTTPS base URL this server is reachable at, no trailing slash (your
# ngrok URL while testing, e.g. https://xxxx.ngrok-free.app — changes every time
# ngrok restarts, same as the Webhook URL above; your real domain in
# production). Only needed for /coc showpage and the Keeper's
# show_scenario_image tool on LINE (LINE's image message needs a real URL, it
# can't take raw bytes). Not needed at all for Discord.
PUBLIC_BASE_URL=

# Discord bot token (only needed to run app/discord_bot.py) — from
# discord.com/developers/applications > your app > Bot > Reset Token.
# Also remember to switch on the "Message Content" privileged intent there,
# under Bot > Privileged Gateway Intents, or the bot won't see message text.
DISCORD_BOT_TOKEN=

# Which LLM plays the Keeper: "anthropic", "gemini", or "openai"
LLM_PROVIDER=anthropic

# Anthropic API key (console.anthropic.com), separate from your Claude Code login
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Google AI Studio API key (aistudio.google.com/apikey), only needed if LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Double-check the current flash model id at https://ai.google.dev before relying on this default
GEMINI_MODEL=gemini-flash-latest

# OpenAI API key (platform.openai.com), only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
# "gpt-5.6-luna" is a best-effort transcription, not a verified model id — double-check
# the exact string at platform.openai.com/docs/models before relying on this default
OPENAI_MODEL=gpt-5.6-luna

# Where per-group game state (characters, scenario text, log) is persisted
DATA_DIR=data/groups

# Heuristic context-budget caps — see the comments in app/config.py for the
# reasoning. Tune down if your model's context window is smaller than Claude
# Sonnet's ~200K tokens; tune up if you've checked it comfortably fits more.
MAX_SCENARIO_CHARS=240000
MAX_LOG_TURNS=80

# Scenario RAG (app/scenario_rag.py) — opt-in, off by default. Off: the full
# scenario text is stuffed into the (cached) system prompt as always, capped by
# MAX_SCENARIO_CHARS. On: the Keeper gets a search_scenario tool instead and
# must query the scenario per-turn via local lexical (BM25) search — no
# embeddings API needed, but loses "whole scenario visible at once". See
# README's 限制 section before turning this on.
SCENARIO_RAG_ENABLED=false
SCENARIO_RAG_TOP_K=5
